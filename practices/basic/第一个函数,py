def quadratic(a : float, b : float, c : float = 0.0) :
    # 处理a等于零
    if a == 0.0 :
        result : float = -(c / b)
        return result, None
    else :
        # 计算判别式
        discriminant = power(b, 2) - 4 * a * c
        # 处理无实数根情况
        if discriminant < 0 :
            return None, None
        else :
            # 计算平方根（现在可以使用我们自己的 power 函数了！）
            sqrt_discriminant = power(discriminant, 0.5)
            x_1 = (-b + sqrt_discriminant) / (2 * a)
            x_2 = (-b - sqrt_discriminant) / (2 * a)
            return x_1, x_2


